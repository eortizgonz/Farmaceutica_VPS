# Copie este archivo como .env y reemplace los valores.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pharma_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=su_password_local
SECRET_KEY=reemplace-con-una-cadena-aleatoria-larga
FLASK_DEBUG=1

