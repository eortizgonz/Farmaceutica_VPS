# Copie este archivo como .env y reemplace los valores.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pharma_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=su_password_local
SECRET_KEY=reemplace-con-una-cadena-aleatoria-larga
FLASK_DEBUG=1

# Recuperación de contraseña con Gmail (use una contraseña de aplicación).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=su_cuenta@gmail.com
MAIL_PASSWORD=password_de_aplicacion_de_google
MAIL_DEFAULT_SENDER=su_cuenta@gmail.com
APP_BASE_URL=http://127.0.0.1:8000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=300
OLLAMA_MAX_TOKENS=220

# Alternativa para proveedores cloud (tiene prioridad sobre las variables anteriores):
# DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/base
